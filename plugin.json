{
  "id": "google",
  "kind": "plugin",
  "version": "1.0.55",
  "label": "Google",
  "description": "Google Gemini for chats, pictures and video. Adds Google under Settings → LLMs → Providers & Keys, the Gemini CLI coding agent, Gemini picture and Veo video tools for every ducky (they ask before spending on your key), and Google workflow nodes.",
  "min_app_version": "1.2.45",
  "default_enabled": true,
  "data_sharing": false,
  "secret_keys": [
    "gemini"
  ],
  "contributes": {
    "llm.providers": [
      {
        "id": "gemini",
        "label": "Google",
        "kind": "secret",
        "secret_key": "gemini",
        "key_url": "https://aistudio.google.com/apikey",
        "order": 30
      }
    ],
    "llm.coding_agents": [
      {
        "id": "gemini_cli",
        "label": "Gemini CLI",
        "order": 110
      }
    ],
    "ide.hookups": [
      {
        "kind": "antigravity",
        "label": "Antigravity"
      }
    ],
    "walkthrough": {
      "id": "google",
      "title": "Set up Google Gemini",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "provider_id": "gemini",
      "steps": [
        {
          "target": "settings.llms.provider.gemini",
          "title": "Open Google",
          "body": "Press the Google row in this table. The page slides open so you can paste a key or use Gemini CLI.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "API key or Gemini CLI",
          "body": "Paste your Google Gemini API key here. No key? Skip this and use Gemini CLI on this same slide.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save after you paste a key. Using Gemini CLI without a key? Press Skip.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.ide",
          "title": "IDE / MCP connection",
          "body": "IDE / MCP wires UEFN tools and Ducky skills into Antigravity. Apply once, then Test. Green check = connected.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.ide.apply",
          "title": "Apply connection",
          "body": "Press Apply (or Re-apply) so UEFN MCP and Ducky skills land in Antigravity. Then Test \u2014 a green check means connected.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent",
          "title": "Gemini CLI",
          "body": "Gemini CLI is Google's coding agent. Detect finds the CLI. Keep it on to pick Gemini CLI in chat.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent.detect",
          "title": "Detect CLI",
          "body": "Press Detect to find Gemini CLI on this machine. Leave the toggle on so it appears in the chat picker.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.back",
          "title": "Back",
          "body": "Press Back to return to the provider list.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    },
    "automations": {
      "image_generators": [
        {
          "id": "gemini_image",
          "label": "Google · Gemini image",
          "tool": "gemini_generate_image",
          "credits": 0,
          "paid": true,
          "cost": "Billed to your own Google API key",
          "args": {
            "model": "auto"
          },
          "image_arg": "image",
          "config_fields": [
            {
              "id": "model",
              "label": "Model",
              "type": "select",
              "options": [
                {
                  "id": "auto",
                  "label": "Auto (gemini-2.5-flash-image)"
                },
                {
                  "id": "gemini-2.5-flash-image",
                  "label": "gemini-2.5-flash-image (fast, lowest price)"
                },
                {
                  "id": "gemini-3.1-flash-image",
                  "label": "gemini-3.1-flash-image (newer, fast)"
                },
                {
                  "id": "gemini-3-pro-image",
                  "label": "gemini-3-pro-image (best quality)"
                }
              ]
            }
          ]
        }
      ],
      "nodes": [
        {
          "id": "google.complete",
          "label": "Google complete",
          "group": "Google",
          "description": "One-shot prompt through the Google gateway. Writes text onto the run.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "model",
              "provider": "gemini"
            }
          ]
        },
        {
          "id": "google.image",
          "label": "Google image",
          "group": "Google",
          "description": "Generate an image with a Gemini image model, from a prompt and an optional reference picture.",
          "accepts_image": true,
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "image",
              "label": "Reference picture (optional)",
              "type": "file",
              "accept": "image/*"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "select",
              "options": [
                {
                  "id": "gemini-2.5-flash-image",
                  "label": "gemini-2.5-flash-image (Nano Banana)"
                },
                {
                  "id": "gemini-3.1-flash-image",
                  "label": "gemini-3.1-flash-image"
                },
                {
                  "id": "gemini-3-pro-image",
                  "label": "gemini-3-pro-image"
                }
              ]
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "google-complete",
          "label": "Google complete",
          "icon": "\u2728",
          "systems": [
            "pipeline"
          ],
          "description": "Chat prompt through Google, then finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat",
                "description": ""
              },
              {
                "id": "c",
                "type": "google.complete",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Complete",
                "description": ""
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": {},
                "label": "Finish",
                "description": ""
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "c",
                "kind": "main"
              },
              {
                "source": "c",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
